{
  "name": "language-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "prettier": {
    "endOfLine": "auto"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "db:login": "node scripts/run-supabase.mjs login",
    "db:link": "node scripts/run-supabase.mjs link",
    "db:migrations": "node scripts/run-supabase.mjs migration list",
    "db:push": "node scripts/run-supabase.mjs db push",
    "db:start": "node scripts/run-supabase.mjs start",
    "db:stop": "node scripts/run-supabase.mjs stop",
    "db:reset": "node scripts/run-supabase.mjs db reset",
    "db:test": "node scripts/run-supabase.mjs test db",
    "db:types": "node scripts/run-supabase.mjs gen types typescript --local --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.55.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.0.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
